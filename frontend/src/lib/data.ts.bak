// ============================================================
// INVICTUS OS — Master Data Store v3
// All mock data. Replace with Supabase queries when ready.
// ============================================================

export type Priority = 'critical' | 'high' | 'medium' | 'low';
export type TaskStatus = 'todo' | 'in_progress' | 'paused' | 'rework' | 'in_review' | 'blocked' | 'done' | 'cancelled';
export type TaskCategory =
  | 'performance_marketing'
  | 'social_media'
  | 'video_editing'
  | 'design_creative'
  | 'web_development'
  | 'whatsapp_automation'
  | 'strategy'
  | 'operations'
  | 'content_writing'
  | 'seo';

export type RoleTag =
  | 'video_editor'
  | 'designer'
  | 'performance_marketer'
  | 'web_developer'
  | 'ai_developer'
  | 'developer'
  | 'ops'
  | 'sales'
  | 'leadership';

export interface Notification {
  id: string;
  userId: string; // The recipient
  actorId: string; // The person who triggered it
  type: 'mention' | 'status_change';
  taskId: string;
  message: string;
  read: boolean;
  createdAt: string; // ISO timestamp
}

// ─────────────────────────────────────────────────────────────
// TIME ENTRY LEDGER (v3 — the source of truth for all analytics)
// ─────────────────────────────────────────────────────────────
export interface TimeEntry {
  id: string;
  taskId: string;
  userId: string;       // WHO logged it — critical for multi-assignee tasks
  startedAt: string;    // ISO timestamp
  endedAt: string;      // ISO timestamp
  minutes: number;      // computed: Math.floor((endedAt - startedAt) / 60000)
  source: 'timer' | 'manual';
  note?: string;
  migrated?: boolean;   // true = synthesized from v2 aggregate on upgrade
}

export interface TaskApproval {
  id: string;
  requestedBy: string;
  approver: string;
  type: 'budget' | 'task_completion';
  status: 'pending' | 'approved' | 'rejected';
  requestMessage?: string;
  responseMessage?: string;
}

export interface Task {
  id: string;
  displayCode?: string;
  sourceType?: 'manual' | 'meeting' | 'lead_stage';
  sourceMeetingTitle?: string;
  sourceTranscriptQuote?: string;
  clientId: string;
  title: string;
  description: string;
  category: TaskCategory;
  assignedTo: string[];
  createdBy: string;
  priority: Priority;
  status: TaskStatus;

  // Hierarchical tasks
  type?: 'goal' | 'task' | 'subtask';
  parentId?: string;

  // Assets & Submission
  requiresAsset?: boolean;
  submissionNotes?: string;
  assets?: { name: string; url: string }[];

  // Review Cycle
  reviewComments?: {
    id: string;
    authorId: string;
    text: string;
    createdAt: string;
    rejectionReason?: 'brief_unclear' | 'brand_mismatch' | 'quality' | 'client_changed_mind';
  }[];

  // Time and Date
  startTime?: string;       // ISO date string for hour-based Gantt
  deadline: string | null;  // ISO date string
  estimatedHours: number;
  loggedMinutes: number;    // cached display total; ledger is source of truth

  // Completion tracking (v3 — set ONCE on → done; cleared on reopen)
  completedAt?: string;     // ISO timestamp
  completedBy?: string;     // userId

  // Task subtype (v3 — for production analytics)
  taskType?: string;        // e.g. 'poster', 'reel_edit', 'landing_page'

  // Shoot-specific (nullable except on shoot tasks)
  shootDate?: string;
  location?: string;
  freelancerName?: string;
  freelancerFeeINR?: number;
  footageUsability?: 'usable' | 'partial' | 'unusable';
  usabilityReason?: 'shake' | 'lighting' | 'audio' | 'framing';

  // Approvals
  approvals?: TaskApproval[];

  createdAt: string;
  updatedAt: string;
  tags: string[];
}

export interface Client {
  id: string;
  code: string;
  name: string;
  category: string;
  monthlyRetainerINR: number;
  agencyFeeINR: number;
  contractStatus: 'active' | 'paused' | 'churned';
  primaryContact: string;
  notes: string;
  budgetUtilization: number; // 0–100
  color: string;
  website?: string;
  isInternal?: boolean; // WhatsNexus, HAGGLE, Invictus internal = true
}

export interface ClientMonthlyMetrics {
  id: string;
  clientId: string;
  month: string; // e.g. '2026-07'
  servicesOffered: string[];
  budgetAllocated: number;
  budgetSpent: number;
  leadsGenerated: number;
  costPerLead: number;
  conversions: number;
  roas: number;
}

export interface TeamMember {
  id: string;
  name: string;
  email: string;
  role: 'admin' | 'ops' | 'team' | 'viewer';
  department: string;
  initials: string;
  hoursThisWeek: number;
  weeklyTarget: number;
  color: string;
  permissions: string[];
  monthlySalaryINR: number; // v3 — real salary for cost analytics
  roleTag: RoleTag;         // v3 — for role-specific analytics views
  isHeadOfDepartment?: boolean; // v3 — for notification routing
  password?: string; // Phase 12 - User credentials (mock)
  mustChangePassword?: boolean; // Forces password change on first login

  // HRMS extensions
  title?: string;
  dob?: string;
  gender?: string;
  bloodGroup?: string;
  joinDate?: string;
  employmentType?: string;
  probationEnd?: string;
  basic?: number;
  hra?: number;
  specialAllowance?: number;
  reportingManager?: string; // id of manager
  workLocation?: string;
  assets?: string; // or structured array, but string is easier given prompt format
  uan?: string;
  pan?: string;
  performanceRating?: number;
  exitDate?: string;
  exitReason?: string;
  monthlyFixed?: number; // for part time
}

export interface AttendanceRecord {
  id: string;
  employeeId: string;
  month: string; // '2026-04'
  present: number;
  late: number;
  absent: number;
  halfDay: number;
  totalHours: number;
  avgIn?: string;
  avgOut?: string;
  notes?: string;
}

export interface Project {
  id: string;
  clientId: string;
  name: string;
  type: string;
  status: 'IN PROGRESS' | 'COMPLETED' | 'TERMINATED' | 'DELIVERED BUT CLIENT EXITED';
  team: string[]; // member IDs
  startDate: string;
  completedDate?: string;
  estimatedHours: number;
  actualHours: number;
  budget?: string;
  notes?: string;
}

export interface PerformanceBenchmark {
  taskType: string;
  targetHours: number;
  agencyAvgActual: number;
  unit: string;
}

export interface LeaveBalance {
  employeeId: string;
  elRemaining: number | string;
  clRemaining: number | string;
  slUsed: number;
  notes?: string;
}

export interface AttendanceLog {
  id: string;
  userId: string;
  date: string; // YYYY-MM-DD
  clockIn: string | null; // ISO timestamp
  clockOut: string | null; // ISO timestamp
  totalMinutes: number;
  status: 'present' | 'late' | 'half_day' | 'absent' | 'leave' | 'holiday' | 'weekend';
  lateFlag: boolean;
  source: 'web' | 'desktop_app' | 'manual_correction' | 'system';
  autoClosed: boolean;
  correctionNote?: string;
}

export interface LeaveType {
  code: string;
  name: string;
  annualAllocation: number;
  accrues: boolean;
  carryForwardMax: number;
}

export interface LeaveLedgerEntry {
  id: string;
  userId: string;
  leaveType: string;
  delta: number;
  reason: 'accrual' | 'approved_leave' | 'cancellation' | 'encashment' | 'adjustment' | 'seed';
  refRequestId?: string;
  createdAt: string;
}

export interface LeaveRequest {
  id: string;
  userId: string;
  leaveType: string;
  startDate: string; // YYYY-MM-DD
  endDate: string; // YYYY-MM-DD
  halfDay: boolean;
  days: number;
  reason: string;
  status: 'pending' | 'approved' | 'rejected' | 'cancelled';
  decidedBy?: string;
  decidedAt?: string;
  decisionNote?: string;
  createdAt: string;
}

export interface Approval {
  id: string;
  kind: 'leave' | 'attendance_correction' | 'comp_off' | 'wfh' | 'asset_request' | 'export' | 'task_review' | 'probation_review';
  refId: string;
  requestedBy: string;
  approverId: string;
  status: 'pending' | 'approved' | 'rejected';
  contextJson: any; // Denormalized display data
  createdAt: string;
  decidedAt?: string;
  decisionNote?: string;
}

export interface CampaignWeeklyLog {
  id: string;
  campaignId: string; // ID of the task or project acting as campaign
  loggedBy: string;
  weekStart: string; // YYYY-MM-DD
  impressions: number;
  clicks: number;
  leads: number;
  spendInr: number;
  cplInr: number; // spendInr / leads
  note?: string;
  createdAt: string;
}

export interface AuditEntry {
  id: string;
  timestamp: string;
  actor: string;
  actorId: string;
  action: string;
  entity: string;
  entityRef: string;
  clientName: string;
  meta: string;
}

export interface Deliverable {
  id: string;
  clientId: string;
  title: string;
  status: 'pending' | 'in_progress' | 'done';
  dueDate: string;
}

export interface ClientCredential {
  id: string;
  clientId: string;
  platform: 'instagram' | 'youtube' | 'facebook' | 'website' | 'hosting';
  username: string;
  passwordStr: string;
  url?: string;
  notes?: string;
}

export interface SocialMetric {
  id: string;
  clientId: string;
  platform: 'instagram' | 'youtube';
  followers: number;
  reach: number;
  engagementRate: number;
  views?: number;
  watchTimeHours?: number;
  lastUpdated: string;
}

